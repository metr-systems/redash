#: redash/handlers/users.py:65 redash/handlers/users.py:137
msgid "Bad email address."
msgstr "Ungültige E-Mail-Adresse."

#: redash/handlers/users.py:153 redash/handlers/users.py:260
msgid "Email already taken."
msgstr "E-Mail bereits vergeben."

#: redash/handlers/users.py:184
msgid "Not found"
msgstr "Nicht gefunden"

#: redash/handlers/users.py:216
msgid "Must provide current password to update password."
msgstr ""
"Aktuelles Passwort muss angegeben werden, um das Passwort zu "
"aktualisieren."

#: redash/handlers/users.py:219
msgid "Incorrect current password."
msgstr "Falsches aktuelles Passwort."

#: redash/handlers/users.py:227
msgid "Must be admin to change groups membership."
msgstr "Muss Administrator sein, um die Gruppenmitgliedschaft zu ändern."

#: redash/handlers/users.py:262
msgid "Error updating record"
msgstr "Fehler beim Aktualisieren des Datensatzes"

#: redash/handlers/users.py:285
msgid ""
"You cannot delete your own account. Please ask another admin to do this "
"for you."
msgstr ""
"Sie können Ihr eigenes Konto nicht löschen. Bitte bitten Sie einen "
"anderen Administrator, dies für Sie zu tun."

#: redash/handlers/users.py:291
msgid "You cannot delete activated users. Please disable the user instead."
msgstr ""
"Sie können aktivierte Benutzer nicht löschen. Bitte deaktivieren Sie "
"stattdessen den Benutzer."

#: redash/handlers/users.py:309
msgid ""
"You cannot disable your own account. Please ask another admin to do this "
"for you."
msgstr ""
"Sie können Ihr eigenes Konto nicht deaktivieren. Bitte bitten Sie einen "
"anderen Administrator, dies für Sie zu tun."

