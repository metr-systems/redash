msgid "Page is out of range."
msgstr "Seite ist außerhalb des Bereichs."

#: redash/handlers/base.py:91
msgid "Page size is out of range (1-250)."
msgstr "Seitengröße ist außerhalb des Bereichs (1-250)."

#: redash/handlers/dashboards.py:319
msgid "Public URLs are disabled."
msgstr "Öffentliche URLs sind deaktiviert."

